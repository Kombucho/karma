# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# karma engine
.cache/
Front-end/

# marketing screenshots, not app code
launch-shots/

# quant lab raw caches (refetchable)
data/lab/cache/
data/lab/*.jsonl
data/lab/**/*.png
data/lab/pattern-sample*.json
data/lab/funnel.json
data/lab/tf-scorecard.json
